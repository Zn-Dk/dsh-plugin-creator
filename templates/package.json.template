{
  "name": "dsh-<plugin-name>",
  "version": "0.1.0",
  "description": "<一句话描述插件做什么，谁用>",
  "type": "module",
  // ⚠️ Host 半区强制 ESM：lib/*.js 一律 import/export，禁止顶层 require/module.exports。
  //    唯一允许 require 的是 Client bundle 的 window.__ModuleLoader__.load({ factory: (require) => {...} }) 闭包。
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    // ↓ 无 GUI 时删除下面这行：纯 Host 插件不导出 client
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "CHANGELOG.md"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://<你的仓库地址>.git" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    // ↓ 无 GUI 时删除整个 "client" 块；有 GUI 才需要（inject 至少含 dsh-client-runtime）
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-connection"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "<依赖的其他插件公共 API>": ">=<版本约束>"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "tsx --test test/*.test.ts",
    "pack": "pnpm pack"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
